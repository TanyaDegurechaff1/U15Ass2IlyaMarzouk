<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Whiskers Cafe - Book a Visit</title>
	<link rel="stylesheet" type="text/css" href="css/style.css">
</head>
<body>

	<div class="navbar">
		<h1>Whiskers Cafe</h1>
		<ul>
			<li><a href="index.html">Home</a></li>
			<li><a href="cats.html">Our Cats</a></li>
			<li><a href="gallery.html">Gallery</a></li>
			<li><a href="menu.html">Menu</a></li>
			<li><a href="booking.html">Book a Visit</a></li>
			<li><a href="care.html">Cat Care</a></li>
			<li><a href="contact.html">Contact</a></li>
		</ul>
	</div>

	<div class="banner">
		<h2>Book a Visit</h2>
		<p>We only let a certain number of people into the cat room at once, so please book ahead.</p>
	</div>

	<div class="section">

		<div id="success-msg">
			Thanks! Your booking request has been sent, we will email you to confirm.
		</div>

		<form id="bookingForm">

			<div class="form-group">
				<label for="name">Full Name</label>
				<input type="text" id="name" name="name">
				<div class="error">Please enter your name.</div>
			</div>

			<div class="form-group">
				<label for="email">Email Address</label>
				<input type="text" id="email" name="email">
				<div class="error">Please enter a valid email address.</div>
			</div>

			<div class="form-group">
				<label for="date">Preferred Date</label>
				<input type="date" id="date" name="date">
				<div class="error">Please choose a date.</div>
			</div>

			<div class="form-group">
				<label for="time">Preferred Time</label>
				<select id="time" name="time">
					<option value="10:00">10:00am</option>
					<option value="11:30">11:30am</option>
					<option value="13:00">1:00pm</option>
					<option value="14:30">2:30pm</option>
					<option value="16:00">4:00pm</option>
				</select>
			</div>

			<div class="form-group">
				<label for="guests">Number of Guests (max 6)</label>
				<input type="number" id="guests" name="guests" min="1" max="6" value="1">
				<div class="error">Please enter a number between 1 and 6.</div>
			</div>

			<div class="form-group">
				<label for="notes">Anything we should know?</label>
				<textarea id="notes" name="notes" rows="3"></textarea>
			</div>

			<button type="submit" class="button">Request Booking</button>

		</form>

	</div>

	<footer>
		Whiskers Cafe, 14 Bridgewater Row, Manchester &nbsp;|&nbsp; hello@whiskerscafe.co.uk
	</footer>

	<script src="js/script.js"></script>
</body>
</html>
